# Google OAuth Client ID for authentication
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# Base API endpoint for frontend requests
VITE_API_URL=http://localhost:3000/api

# Root API URL, used across client services
VITE_API_BASE_URL=http://localhost:3000

# Facebook Client ID for Facebook login integration
VITE_FACEBOOK_CLIENT_ID=your-facebook-client-id-here

# Development mode flag
VITE_DEV=development

# Google Maps API key for geolocation and map rendering
VITE_REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# TMDB (The Movie Database) public API key for fetching movie/TV data
VITE_TMDB_API_KEY=your-tmdb-api-key-here

# TMDB access token (JWT) for advanced API operations
VITE_TMDB_ACCESS_TOKEN=your-tmdb-access-token-here

# Default profile image URL used when user has no avatar
VITE_DEFAULT_PROFILE_IMAGE=your-default-image-url-here

# Stripe publishable key for client-side payment processing
VITE_STRIPE_PUBLISH_KEY=your-stripe-publishable-key-here